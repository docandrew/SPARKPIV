library project SparkPIV is
   for Library_Name use "sparkpiv";
   for Library_Kind use "static";
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwJ", "-gnatyyM120", "-O2", "-gnatn", "-gnata");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=1", "--prover=z3,cvc5,altergo");
   end Prove;
end SparkPIV;
