--  Optional Linux transport for SPARKPIV: PIV.Linux_USB (CCID over
--  /dev/bus/usb, plain Ada, not SPARK). Consumers that want it `with` this
--  project instead of sparkpiv.gpr; it brings sparkpiv.gpr along.
with "sparkpiv.gpr";

library project SparkPIV_Linux is
   for Library_Name use "sparkpiv_linux";
   for Library_Kind use "static";
   for Source_Dirs use ("src-linux");
   for Object_Dir use "obj-linux";
   for Library_Dir use "lib-linux";
   for Create_Missing_Dirs use "True";
   package Compiler is
      --  -fno-tree-vrp: see sparkpiv.gpr.
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwJ", "-gnatyyM120", "-O2", "-fno-tree-vrp");
   end Compiler;
end SparkPIV_Linux;
